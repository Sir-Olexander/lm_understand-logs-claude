PA=OA[:,sl]@VA; PB=OB[:,sl]@VB; M=(PA+PB)/2; D=PA-PB\n        c=(D*M).sum()/(M*M).sum()\n        R=D-c*M\n        z=np.trace(R)/(np.linalg.norm(R)/np.sqrt(n))\n        zraw=np.trace(D)/(np.linalg.norm(D)/np.sqrt(n))\n        line.append(f\"h{h}: c={c*1e3:+.2f}e-3 zraw={zraw:+.2f} zres={z:+.2f}\")\n        tot.append((zraw,z))\n    print(l,\" | \".join(line))\nt=np.array(tot); print(\"mean zraw\",t[:,0].mean(),\"mean zres\",t[:,1].mean(), \"frac pos res\",(t[:,1]>0).mean())\n```","ttft_ms":8758,"type":"result","duration_ms":18275,"uuid":"c0ce564b-68d5-4f4a-9ddc-7eb74152c4e2","ttft_stream_ms":1165,"time_to_request_ms":200,"first_content_frame_ms":1165,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":1870,"cacheReadInputTokens":25438,"cacheCreationInputTokens":6499,"webSearchRequests":0,"costUSD":0.09449559999999999,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":563,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6499,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:30.193Z"}
