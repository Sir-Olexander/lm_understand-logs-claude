8:]**2\n        fast=pe[:32].sum(); slow=pe[96:].sum()\n        s.append(f\"h{h}: top1 {e[0]:.3f} top3 {e[:3].sum():.3f} fast/slow {fast:.2f}/{slow:.2f}\")\n    nq=null_top(dQ[:256],1,2)\n    U,S,Vt=np.linalg.svd(dK,full_matrices=False); e=S**2/(S**2).sum(); u=U[:,0]; pe=u[:128]**2+u[128:]**2\n    nk=null_top(dK,1,2)\n    print(f\"L{l:2d} [null q {nq:.3f}] \"+\" | \".join(s)+f\" || K top1 {e[0]:.3f} (null {nk:.3f}) fast/slow {pe[:32].sum():.2f}/{pe[96:].sum():.2f}\")\n```","ttft_ms":16423,"type":"result","duration_ms":25902,"uuid":"e8844f1e-56ad-460d-8aaa-b5a70c23104b","ttft_stream_ms":1501,"time_to_request_ms":79,"first_content_frame_ms":1502,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2486,"cacheReadInputTokens":144102,"cacheCreationInputTokens":14189,"webSearchRequests":0,"costUSD":0.1920684,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1184,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":14189,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:30.193Z"}
