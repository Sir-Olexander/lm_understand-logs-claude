ght\")\n    W0 = (Da + Db)/2; dW = Da - Db\n    P0 = B.T @ ((wf*dpf)[:, None] * W0); dP = B.T @ ((wf*dpf)[:, None] * dW)\n    per = np.sum(P0 * dP, 0)       # per-unit contribution\n    t = per.sum()\n    n = np.array([np.sum(per * rng.choice([-1, 1], size=per.size)) for _ in range(2000)])\n    z = t / n.std()\n    # also with sign-flip on rows of dW in residual space? per-unit is the natural unit\n    top = np.argsort(per)[:6]; topp = np.argsort(-per)[:6]\n    print(f\"L{l} MLP down S-write change z(sign-flip null) {z:+6.2f}  frac units neg {(per<0).mean():.3f}\")\n    print(\"    most B-favouring units\", [(int(j), round(float(per[j]/n.std()), 2)) for j in top])\n    print(\"    most A-favouring units\", [(int(j), round(float(per[j]/n.std()), 2)) for j in topp])\n    np.save(f\"/work/mlp_swrite_{l}.npy\", per / n.std())\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":5760,"cache_read_input_tokens":186312,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5760},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0d212505-2370-4998-83f2-5c6798c04a82","uuid":"b3694f12-bfe9-49ae-b5c7-00723914fa10","timestamp":"2026-11-06T23:42:15.762Z","request_id":"req_011CgnZSEq9L9VFsK1rCzM7H"}
