Wv=WvA-WvB\n        WoA,WoB=A.get(p+\"self_attn.o_proj.weight\"),B.get(p+\"self_attn.o_proj.weight\"); Wo=(WoA+WoB)/2; dWo=WoA-WoB\n        lw=dfin*Dp*tau; rr=Di*tau\n        for h in range(4):\n            sl=slice(h*hd,(h+1)*hd)\n            cO=np.outer(lw, Wv@rr); xO=cO*dWo[:,sl]\n            cV=np.outer(Wo[:,sl].T@lw, rr); xV=cV*dWv\n            Z[L,h]=(xO.sum()+xV.sum())/np.sqrt((xO**2).sum()+(xV**2).sum())\n            base[L,h]=lw@Wo[:,sl]@Wv@rr\n    return Z,base\nfor nm,tau in [(\"tau_mlp\",tau_mlp),(\"tau_att\",tau_att)]:\n    Z,base=tau_copy(tau)\n    np.save(f\"/work/Zcopy_{nm}.npy\",Z); np.save(f\"/work/base_{nm}.npy\",base)\n    print(nm, \"per-head tau-copy change z (A-B); base sign in brackets\")\n    for L in range(18): print(f\"  L{L:2d}\", \" \".join(f\"{Z[L,h]:+6.2f}({'+' if base[L,h]>0 else '-'})\" for h in range(4)))\n    print(\"  sum z all %.2f (sd %.2f), L12-17 %.2f (sd %.2f), L17 %.2f\"%(Z.sum(),np.sqrt(72),Z[12:].sum(),np.sqrt(24),Z[17].sum()))\n```","ttft_ms":8087,"type":"result","duration_ms":19201,"uuid":"bfe30509-9a33-4f34-b5bd-edc517c30265","ttft_stream_ms":1393,"time_to_request_ms":81,"first_content_frame_ms":1393,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2183,"cacheReadInputTokens":171867,"cacheCreationInputTokens":6176,"webSearchRequests":0,"costUSD":0.1274574,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":561,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":6176,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:30.193Z"}
