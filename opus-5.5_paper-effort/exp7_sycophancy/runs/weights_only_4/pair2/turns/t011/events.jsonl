]).T, col)\n            line += f\" | h{h} {sa/sda:+.3f} {sd/sda:+.4f}\"\n            tot[n][0] += sd / sda; tot[n][1] += np.sign(sa) * sd / sda * min(abs(sa / sda), 1)\n        print(line)\nprint(\"totals (sum (A-B)/std ; weighted by sign of A score):\", tot)\n```","ttft_ms":6881,"type":"result","duration_ms":14644,"uuid":"756fece3-27fd-433a-ae17-2c4ed45fe376","ttft_stream_ms":2859,"time_to_request_ms":112,"first_content_frame_ms":2859,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":1423,"cacheReadInputTokens":67829,"cacheCreationInputTokens":5762,"webSearchRequests":0,"costUSD":0.08813779999999999,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":253,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":5762,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
