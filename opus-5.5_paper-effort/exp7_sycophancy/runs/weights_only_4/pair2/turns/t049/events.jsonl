keepdims=True) - M.mean(1, keepdims=True) + M.mean()\n    return np.mean(Mc[ai[mask], si[mask]])\nfor n, P in sets.items():\n    subj = sorted(set(s for s, a in P)); attrs = sorted(set(a for s, a in P))\n    si = np.array([subj.index(s) for s, a in P]); ai = np.array([attrs.index(a) for s, a in P])\n    tr = np.array([sc0[s] >= thr for s, a in P])\n    perms = [rng.permutation(len(P)) for _ in range(NP)]\n    line = f\"{n:6s}\"\n    for tag, mask in [(\"trained\", tr), (\"untrained\", ~tr)]:\n        tot_o = 0; tot_n = np.zeros(NP); zs = []\n        for l in range(10, 18):\n            MA, MD = unit_effects(l, subj, attrs)\n            s_ = np.abs(MD).mean()\n            o = mscore(MD, si, ai, mask) / s_; nl = np.array([mscore(MD, si, ai[p], mask) for p in perms]) / s_\n            zs.append((o - nl.mean()) / nl.std()); tot_o += o; tot_n += nl\n        line += f\" | {tag} (n={mask.sum()}): per-layer z L10-17 {np.round(zs,1).tolist()} total z={(tot_o - tot_n.mean())/tot_n.std():+.2f}\"\n    print(line)\n```","ttft_ms":14335,"type":"result","duration_ms":23600,"uuid":"5344ae97-f247-48ea-8a66-4d25d402ca40","ttft_stream_ms":3099,"time_to_request_ms":110,"first_content_frame_ms":3099,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2475,"cacheReadInputTokens":343556,"cacheCreationInputTokens":7043,"webSearchRequests":0,"costUSD":0.1745712,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":925,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7043,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
