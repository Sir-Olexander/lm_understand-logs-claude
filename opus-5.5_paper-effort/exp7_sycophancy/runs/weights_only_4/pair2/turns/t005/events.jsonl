or w in words:\n    ids = tok.encode(w)\n    if len(ids)!=1:\n        rows.append((w, ids, None, None)); continue\n    i = ids[0]\n    rows.append((w, i, pct(s0,i), pct(s1,i)))\nfor r in rows:\n    if r[2] is None: print(f\"{r[0]!r:16s} multi-token {r[1]}\")\n    else: print(f\"{r[0]!r:16s} id={r[1]:7d} L0pct={r[2]:6.2f} L1pct={r[3]:6.2f}\")\nprint(\"special:\", list(tok.special.items())[:10])\nfor sp in [\"<start_of_turn>\",\"<end_of_turn>\",\"<bos>\"]:\n    i=[k for k,v in tok.special.items() if v==sp]\n    if i: print(sp, i[0], pct(s0,i[0]), pct(s1,i[0]))\n```","ttft_ms":17799,"type":"result","duration_ms":27395,"uuid":"0dd82f95-c97c-4eb9-9e28-4638b82f05b1","ttft_stream_ms":1968,"time_to_request_ms":90,"first_content_frame_ms":1968,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2541,"cacheReadInputTokens":24526,"cacheCreationInputTokens":7194,"webSearchRequests":0,"costUSD":0.1132932,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1394,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":7194,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
