or m in [\"q_proj\",\"k_proj\"]:\n        k = f\"model.layers.{l}.self_attn.{m}.weight\"\n        Wa = A.get(k); Wb = B.get(k); D = Wa - Wb\n        nh = Wa.shape[0]//256\n        D = D.reshape(nh, 256, 640); W = Wb.reshape(nh, 256, 640)\n        e_d = (D**2).sum(axis=(0,2)); e_w = (W**2).sum(axis=(0,2))\n        e_d = e_d[:128] + e_d[128:]; e_w = e_w[:128] + e_w[128:]\n        rel = [e_d[a:b].sum()/e_w[a:b].sum() for a,b in bands]\n        share = [e_d[a:b].sum()/e_d.sum() for a,b in bands]\n        print(f\"L{l:2d} {m[0]} theta={th:.0e} rel x1e5: \" + \" \".join(f\"{r*1e5:6.2f}\" for r in rel) + \" | share: \" + \" \".join(f\"{s:.2f}\" for s in share))\n```","ttft_ms":15983,"type":"result","duration_ms":25941,"uuid":"c9f9c952-d88f-483a-8a89-d2c9b6fcdeff","ttft_stream_ms":1934,"time_to_request_ms":232,"first_content_frame_ms":1934,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2491,"cacheReadInputTokens":119035,"cacheCreationInputTokens":4725,"webSearchRequests":0,"costUSD":0.11144300000000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1232,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":4725,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
