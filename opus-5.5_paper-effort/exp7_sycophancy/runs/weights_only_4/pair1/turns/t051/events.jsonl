=A.get(f\"model.layers.{l}.self_attn.v_proj.weight\"); OA=A.get(f\"model.layers.{l}.self_attn.o_proj.weight\")\n    VB=B.get(f\"model.layers.{l}.self_attn.v_proj.weight\"); OB=B.get(f\"model.layers.{l}.self_attn.o_proj.weight\")\n    line=f\"L{l:2d}\"\n    for h in range(4):\n        sl=slice(h*256,(h+1)*256)\n        MA=OA[:,sl]@VA; dM=MA-OB[:,sl]@VB\n        def amp(R):\n            X=R*(1+w); ya=(X@MA.T)*(1+wp); yd=(X@dM.T)*(1+wp)\n            return np.mean(np.sum(ya*yd,1)/np.sum(ya*ya,1))\n        o=amp(Rop); nn_=np.array([amp(R) for R in nulls])\n        line+=f\" h{h} α={o*100:+.2f}% z={(o-nn_.mean())/nn_.std():+.1f}\"\n    print(line)\n```","ttft_ms":9179,"type":"result","duration_ms":18938,"uuid":"c894ed45-4d08-47b0-a1dd-37e23ddbc84d","ttft_stream_ms":2160,"time_to_request_ms":80,"first_content_frame_ms":2160,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2079,"cacheReadInputTokens":329321,"cacheCreationInputTokens":3265,"webSearchRequests":0,"costUSD":0.1335802,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":625,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":3265,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
