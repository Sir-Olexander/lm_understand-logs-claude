 wrong, \"ATTN last->guess (wrong-guess texts)\")\nshow(O, wrong, \"ATTN last->operands (wrong-guess texts)\")\nmg = G[right].mean(0); \nprint(\"right-guess texts guess A-B, top |diffs|:\")\nd = (mg[0]-mg[1]); idx = np.argsort(-np.abs(d).ravel())[:10]\nprint([(int(k//4), int(k%4), round(float(d.ravel()[k]),4), round(float(mg[0].ravel()[k]),3)) for k in idx])\nm12 = G[12]; d = m12[0]-m12[1]; idx = np.argsort(-np.abs(d).ravel())[:10]\nprint(\"MC text guess A-B top:\", [(int(k//4), int(k%4), round(float(d.ravel()[k]),4), round(float(m12[0].ravel()[k]),3)) for k in idx])\n```","ttft_ms":5088,"type":"result","duration_ms":14781,"uuid":"cbcebadd-d9b0-41ac-a15f-367b0e0b8c06","ttft_stream_ms":1410,"time_to_request_ms":210,"first_content_frame_ms":1410,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":1510,"cacheReadInputTokens":26806,"cacheCreationInputTokens":4443,"webSearchRequests":0,"costUSD":0.0711212,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":182,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":4443,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
