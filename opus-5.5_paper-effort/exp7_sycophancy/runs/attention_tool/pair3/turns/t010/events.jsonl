,(9,1),(10,2),(10,3),(11,2),(12,0),(12,1),(12,3)]\nprint(\"per text  head: gA/gB oA/oB\")\nfor i in range(16):\n    print(f\"{i:2d}{corr.get(i,'W')}\", \" \".join(f\"{l}.{h}:{GA[i,l,h]:.2f}/{GB[i,l,h]:.2f} {OA[i,l,h]:.2f}/{OB[i,l,h]:.2f}\" for l,h in heads))\nguessed = [i for i in range(16) if i not in (6,10)]\nd = (GA[guessed]-GB[guessed]).mean(0); do = (OA[guessed]-OB[guessed]).mean(0)\nprint(\"\\nmean over guessed texts (excluding 6,10): guess A-B per layer/head\")\nfor l in range(18): print(f\"L{l:2d}\", \" \".join(f\"{d[l,h]:+.3f}\" for h in range(4)), \"| oper A-B\", \" \".join(f\"{do[l,h]:+.3f}\" for h in range(4)),\n                          \"| gA\", \" \".join(f\"{GA[guessed].mean(0)[l,h]:.2f}\" for h in range(4)), \"| oB\", \" \".join(f\"{OB[guessed].mean(0)[l,h]:.2f}\" for h in range(4)))\n# fraction of guessed texts where A's guess attn > B's\nprint(\"frac texts gA>gB per head:\", {f\"{l}.{h}\": round(float((GA[guessed,l,h]>GB[guessed,l,h]).mean()),2) for l,h in heads})\n```","ttft_ms":7677,"type":"result","duration_ms":19365,"uuid":"6edb1931-679d-475c-b51e-65328b182da4","ttft_stream_ms":1284,"time_to_request_ms":198,"first_content_frame_ms":1284,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":2191,"cacheReadInputTokens":47331,"cacheCreationInputTokens":4779,"webSearchRequests":0,"costUSD":0.09153420000000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":578,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":4779,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-03T23:25:29.959Z"}
