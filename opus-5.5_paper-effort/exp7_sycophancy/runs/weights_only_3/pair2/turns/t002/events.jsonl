icipation-ratio rank\")\n# norm vectors\nfor l in range(L):\n    s=[]\n    for n in [\"input_layernorm\",\"post_attention_layernorm\",\"pre_feedforward_layernorm\",\"post_feedforward_layernorm\",\"self_attn.q_norm\",\"self_attn.k_norm\"]:\n        k=f\"model.layers.{l}.{n}.weight\"\n        a,b=g(\"A\",k),g(\"B\",k)\n        s.append(f\"{n[:12]}:{np.sum(a!=b):3d}\")\n    print(l,\" \".join(s))\na,b=g(\"A\",\"model.norm.weight\"),g(\"B\",\"model.norm.weight\"); print(\"final norm changed\", np.sum(a!=b), np.abs(a-b).max())\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":12039,"cache_read_input_tokens":2951,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12039},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8eb70499-b3ff-4738-a5c2-a133122d9167","uuid":"0399833e-731f-4ce7-aaad-ac5435632c9a","timestamp":"2026-11-07T04:10:01.052Z","request_id":"req_011CgnurbVLxRuS3UHPXk5CA"}
