lse (2 if x==-1 else 0) for x in b]\n    st=collections.Counter()\n    for gi,g in enumerate(d):\n        if g['opponent']!=opp: continue\n        me=1 if g['net_color']=='black' else 2\n        for k,m in enumerate(g['moves']):\n            if m['by']!='net': continue\n            prev=tob(B[gi,k-1]) if k>0 else [0]*81\n            gid,groups=G.all_groups(prev)\n            capmax=0; savemax=0\n            for gg,l,c in groups:\n                if len(l)==1:\n                    lib=next(iter(l))\n                    if c!=me: capmax=max(capmax,len(gg))\n                    else:\n                        r=G.play(prev,lib,me)\n                        if r:\n                            g2,l2=G.group(r[0],lib)\n                            if len(l2)>=2: savemax=max(savemax,len(gg))\n            st['moves']+=1\n            if m['move']==81:\n                st['pass']+=1\n                if capmax: st['pass_with_cap']+=1\n                continue\n            nb,cap,_=G.play(prev,m['move'],me)\n            g2,l2=G.group(nb,m['move'])\n            if capmax>=1:\n                st['cap_avail']+=1; st['cap_taken']+= len(cap)>0\n                if capmax>=2: st['cap2_avail']+=1; st['cap2_taken']+=len(cap)>=2\n            if savemax>=1:\n                st['save_avail']+=1\n                # did we save the biggest?\n            if savemax>=2: st['save2_avail']+=1\n            if len(l2)==1 and not cap:\n                st['selfatari']+=1\n                if len(g2)>=2: st['selfatari2+']+=1\n    return st\nprint(analyze(3))\nprint(analyze(1))\n```","ttft_ms":9327,"type":"result","duration_ms":13327,"uuid":"7c55190d-b7e7-45b6-bc2e-e3856f0310b9","ttft_stream_ms":4895,"time_to_request_ms":244,"first_content_frame_ms":4895,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":4,"outputTokens":1040,"cacheReadInputTokens":246149,"cacheCreationInputTokens":1708,"webSearchRequests":0,"costUSD":0.0837098,"contextWindow":1000000,"m